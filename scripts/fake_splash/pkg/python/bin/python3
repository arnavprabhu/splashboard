#!/bin/sh
# Stands in for Splash's bundled interpreter: FAKE_SPLASH_PYTHON, else the
# first Python 3.12+ on PATH.
if [ -n "${FAKE_SPLASH_PYTHON:-}" ]; then
    exec "$FAKE_SPLASH_PYTHON" "$@"
fi
for python in python3.13 python3.12 python3.14 python3; do
    if command -v "$python" >/dev/null 2>&1 \
        && "$python" -c 'import sys; raise SystemExit(sys.version_info[:2] < (3, 12))' >/dev/null 2>&1; then
        exec "$python" "$@"
    fi
done
echo "fake splash: needs Python 3.12+; set FAKE_SPLASH_PYTHON" >&2
exit 1
