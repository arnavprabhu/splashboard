#!/bin/sh
# Fake native engine binary. Only `device-check` is meaningful (the fake HTTP
# server simulates serve-native in process). FAKE_SPLASH_DEVICE_CHECK=fail
# makes it refuse the Mac the way runtime/main.mm checkDevice does
# (message: runtime/metal/DeviceCapabilities.cpp validationMessage; exit 70
# is NativeProcessExit::EngineFailure, runtime/engine/FdTransport.hpp).
if [ "$#" -eq 1 ] && [ "$1" = "device-check" ]; then
    if [ "${FAKE_SPLASH_DEVICE_CHECK:-}" = "fail" ]; then
        echo "error: Splash needs Apple GPU family 9 or newer (M3 or later) on macOS 26.4 or newer; this Mac has Apple M1 (Apple GPU family 7) on macOS 26.4.0 (apple_gpu_family_9_required)" >&2
        exit 70
    fi
    exit 0
fi
echo "usage: $0 serve-native MODEL_DIRECTORY MAX_CONTEXT|auto MAX_MEMORY_BYTES|auto [MAX_CACHE_DISK_BYTES] [--kv-format int8|bf16] [--decode-share SHARE] [--max-image-patches PATCHES] [--cache-dir DIRECTORY]" >&2
exit 2
