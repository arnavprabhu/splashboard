<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the bundled interpreter, but only in an ad hoc build (identity "-" in sign.sh).
  An ad hoc signature has no team identifier, and library validation then
  refuses every bundled .so module (ImportError: "different Team IDs", measured 2026-10-07). This key turns library
  validation off for the interpreter, and nothing else. The hardened runtime stays on. Identity builds (Apple
  Development now, Developer ID later) use python.plist, which stays empty, so they keep library validation.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
