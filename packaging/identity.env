# App identity, read by macos/scripts/bundle.sh (and by package.sh through bundle.sh).
#
# The app is Splashboard, io.github.arnavprabhu.splashboard. Releases
# are signed ad hoc, so there is no team id, and the Sparkle feed is the source repo's latest release.
# Change the values here, not in the scripts or the Swift code. Swift reads the label from
# Info.plist (SplashGUIAgentLabel).
#
# Shell syntax: KEY=VALUE, no spaces around "=", no command substitution.

# Bundle identifier. The verify variant appends ".verify" (see bundle.sh --variant verify).
BUNDLE_ID=io.github.arnavprabhu.splashboard

# LaunchAgent label of the manager. The plist is Contents/Library/LaunchAgents/<label>.plist.
AGENT_LABEL=io.github.arnavprabhu.splashboard.manager

# Keychain service prefix. Not read by any script: the manager's KEYCHAIN_PREFIX in
# manager/splash_gui/secrets.py must say the same. On a change, add the old prefix to
# LEGACY_PREFIXES there so the manager moves the items, and the old AGENT_LABEL to
# DevAgentMigration.legacyLabels (macos/.../System/Migration.swift), as the Splashboard rename did.
KEYCHAIN_PREFIX=io.github.arnavprabhu.splashboard

# Apple team id for Developer ID signing. Empty: releases are signed ad hoc.
TEAM_ID=

# Sparkle feed and public key. The private key is in the user's login Keychain (generate_keys
# --account splashboard) and in the source repo's SPARKLE_ED_PRIVATE_KEY Actions secret.
SU_FEED_URL=https://github.com/arnavprabhu/splashboard/releases/latest/download/appcast.xml
SU_PUBLIC_ED_KEY=4TAymlqSS+kvoum+JWVd1vRQ5iplkqjEa+fYycBEdvU=
