# App identity, read by macos/scripts/bundle.sh (and by package.sh through bundle.sh).
#
# Every value is a placeholder until three things arrive: the owner's Q10 decision (the name and
# bundle id, now D62: Splashboard, io.github.arnavprabhu.splashboard, switched in PKG-16), the
# Developer ID certificate (PKG-8), and the Sparkle EdDSA key (PKG-9/10). Change the values here,
# not in the scripts or the Swift code. Swift reads the label from Info.plist (SplashGUIAgentLabel).
#
# Shell syntax: KEY=VALUE, no spaces around "=", no command substitution.

# Bundle identifier. The verify variant appends ".verify" (see bundle.sh --variant verify).
BUNDLE_ID=ai.splashgui.app

# LaunchAgent label of the manager. The plist is Contents/Library/LaunchAgents/<label>.plist.
AGENT_LABEL=ai.splashgui.manager

# Apple team id for signing. Empty until the Developer ID certificate exists (PKG-6/PKG-8).
TEAM_ID=

# Sparkle feed and public key. Empty until the appcast hosting (Q34) and the EdDSA key exist (PKG-9/10).
SU_FEED_URL=
SU_PUBLIC_ED_KEY=
